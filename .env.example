# Service runtime
TV_AGENT_ENVIRONMENT=development
TV_AGENT_HOST=0.0.0.0
TV_AGENT_PORT=8765
TV_AGENT_LOG_LEVEL=INFO
TV_AGENT_DOCS_ENABLED=true

# Optional bearer credential for TV clients. Configure before exposing the service.
TV_AGENT_SERVICE_API_KEY=

# Douban provider
TV_AGENT_DOUBAN_BASE_URL=https://frodo.douban.com
TV_AGENT_DOUBAN_API_KEY=
TV_AGENT_DOUBAN_TIMEOUT_SECONDS=5

# OpenAI-compatible DeepSeek endpoint
TV_AGENT_LLM_BASE_URL=https://api.deepseek.com
TV_AGENT_LLM_API_KEY=
TV_AGENT_LLM_MODEL=deepseek-flash
TV_AGENT_LLM_TIMEOUT_SECONDS=15
TV_AGENT_LLM_REASONING_EFFORT=high

# Bounded resolver loop
TV_AGENT_AGENT_MAX_ROUNDS=3
TV_AGENT_AGENT_MAX_TOOL_CALLS=5

# SQLite cache
TV_AGENT_DATABASE_PATH=data/tv-agent.db
TV_AGENT_MATCHED_CACHE_TTL_SECONDS=2592000
TV_AGENT_CANDIDATE_CACHE_TTL_SECONDS=86400
